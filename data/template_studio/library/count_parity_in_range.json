{
  "schema_version": 1,
  "language": "ru",
  "template_id": "count_parity_in_range",
  "module_id": "integer_interval_counting",
  "solver_strategy": "formula",
  "answer_type": "integer",
  "candidate_template_text": "{hero:nom} {hero:g,выписал|выписала} подряд все {parity} числа от {low} до {high}. Сколько чисел {hero:nom} {hero:g,выписал|выписала}?",
  "parameter_schema": {
    "hero": {
      "type": "character"
    },
    "low": {
      "type": "integer",
      "min": 11,
      "max": 500
    },
    "high": {
      "type": "integer",
      "min": 100,
      "max": 1200
    },
    "parity": {
      "type": "choice",
      "allowed_values": [
        "чётные",
        "нечётные"
      ]
    }
  },
  "derived_values": {
    "evens": "high // 2 - (low - 1) // 2",
    "odds": "(high + 1) // 2 - low // 2",
    "count": "evens if parity == 'чётные' else odds"
  },
  "constraints": [
    "high - low >= 100",
    "count >= 30"
  ],
  "answer_expression": "count",
  "answer_rendering": {
    "type": "integer",
    "parts": [
      {
        "label": "",
        "value": "count"
      }
    ]
  },
  "grammar_metadata": {
    "notes": "«Чётные» и «нечётные» — форма винительного множественного, одинаковая для обоих вариантов."
  },
  "source_metadata": {
    "problem_number": "89, 94, 98, 103, 889, 894, 1135, 1210, 1335, 1410",
    "filename": "docs/06_podschet_tselyh_chisel_v_promezhutkah.md"
  },
  "notes": "Десять задач-близнецов: менялись только границы и чётность. Границы обе включаются — так в источнике.",
  "math_notes": {
    "level": "base",
    "structure": "Подсчёт чисел заданной чётности на отрезке.",
    "math": [
      "Чётных в [low, high]: high//2 - (low-1)//2.",
      "Нечётных: (high+1)//2 - low//2.",
      "Обе формулы верны при любой чётности границ — в этом вся трудность темы.",
      "Контроль: нечётные 21..301 -> 141; чётные 318..1006 -> 345;",
      "          нечётные 15..277 -> 132; чётные 241..999 -> 379."
    ]
  }
