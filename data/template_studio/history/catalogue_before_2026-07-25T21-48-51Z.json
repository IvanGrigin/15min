    {
      "template_id": "coin_ratio_three_people",
      "module_id": "money_purchases_prices_and_calculations",
      "candidate_template_text": "У {a:gen}, {b:gen} и {c:gen} вместе {coin:count,total}. У {a:gen} монет в {razok:count,ratio} {relation}, чем у {b:gen}, и на {coin:count,diff2} больше, чем у {c:gen}. Сколько монет у {a:gen}?",
      "parameter_schema": {
        "a": {
          "type": "character",
          "universe": "Обычные имена"
        },
        "b": {
          "type": "character",
          "universe": "Обычные имена"
        },
        "c": {
          "type": "character",
          "universe": "Обычные имена"
        },
        "coin": {
          "type": "noun",
          "lemma": "монета"
        },
        "razok": {
          "type": "noun",
          "lemma": "раз"
        },
        "total": {
          "type": "integer",
          "min": 50,
          "max": 3000
        },
        "ratio": {
          "type": "choice",
          "allowed_values": [
            2,
            3,
            4,
            5
          ]
        },
        "diff2": {
          "type": "integer",
          "min": 2,
          "max": 20
        },
        "relation": {
          "type": "choice",
          "allowed_values": [
            "меньше",
            "больше"
          ]
        }
      },
      "derived_values": {
        "a_count": "((total + diff2) // (ratio + 2)) if relation == 'меньше' else (((total + diff2) * ratio) // (2 * ratio + 1))",
        "b_count": "(a_count * ratio) if relation == 'меньше' else (a_count // ratio)",
        "c_count": "a_count - diff2"
      },
      "constraints": [
        "(relation == 'меньше' and (total + diff2) % (ratio + 2) == 0) or (relation == 'больше' and ((total + diff2) * ratio) % (2 * ratio + 1) == 0)",
        "relation == 'меньше' or a_count % ratio == 0",
        "a_count > 0",
        "b_count > 0",
        "c_count > 0",
        "a_count != b_count",
        "a_count != c_count"
      ],
      "answer_expression": "a_count",
      "answer_type": "integer",
      "answer_rendering": {
        "type": "integer",
        "parts": [
          {
            "label": "",
            "value": "a_count",
            "unit": "монета"
          }
        ]
      },
      "grammar_metadata": {
        "hero_role": "a=герой вопроса, b=сравнение по кратности, c=сравнение по разности",
        "notes": "relation — сырая строка 'меньше'/'больше', подставляется напрямую слотом {relation} без падежа; управляет и текстом, и веткой формулы через IfExp."
      },
      "source_metadata": {
        "problem_number": "161, 238",
